[Unit]
Description=CGD FastAPI backend (gunicorn)
After=network.target

[Service]
Type=simple

# --- Adjust these for your EC2 host ---
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/cgd_api

# Load .env from WorkingDirectory (systemd will read KEY=VALUE lines)
EnvironmentFile=/opt/cgd_api/.env

# Use venv gunicorn
# --timeout 300: Allow 5 minutes for long-running requests (e.g., GO Term Finder with large gene lists)
# --graceful-timeout 30: Time to finish existing requests on reload
ExecStart=/opt/cgd_api/.venv/bin/gunicorn \
  -k uvicorn.workers.UvicornWorker \
  -w 2 \
  -b 127.0.0.1:8000 \
  --timeout 300 \
  --graceful-timeout 30 \
  cgd.main:app

Restart=always
RestartSec=3

# Helpful for debugging startup issues
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
